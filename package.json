{
  "name": "torresmedical",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "concurrently -n shared,api \"pnpm --filter @torres/shared dev\" \"pnpm --filter @torres/api dev\"",
    "dev:web": "concurrently -n shared,web \"pnpm --filter @torres/shared dev\" \"pnpm --filter @torres/web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @torres/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @torres/shared build && pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "9.2.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
