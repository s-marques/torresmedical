  tipo          AtividadeNegocioTipo
  titulo        String
  descricao     String?
  dataHora      DateTime               @map("data_hora") @db.Timestamptz(3)
  /// Usuário (configuracoes-gestao), sem FK.
  responsavelId String?                @map("responsavel_id") @db.Uuid
