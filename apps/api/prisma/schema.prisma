  formaPagamentoId String?     @map("forma_pagamento_id") @db.Uuid
  parcelas         Int         @default(1)
  /// Desconto geral em R$ (campo "Desconto (R$)").
  desconto         Decimal     @default(0) @db.Decimal(12, 2)
  subtotal         Decimal     @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  status           VendaStatus @default(FINALIZADA)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3)

  paciente       Paciente?       @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
