/// Dono: comercial-atendimento. Negócio/oportunidade do CRM (telas Pipeline, Negócios e
/// Atividades). Exclusão lógica: histórico comercial.
model Negocio {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineId             String              @map("pipeline_id") @db.Uuid
  estagioId              String              @map("estagio_id") @db.Uuid
  titulo                 String
  valor                  Decimal?            @db.Decimal(12, 2)
  /// Contato: paciente (comercial-atendimento) ou profissional (gestao-profissionais), sem FK.
  contatoTipo            NegocioContatoTipo? @map("contato_tipo")
  contatoId              String?             @map("contato_id") @db.Uuid
  /// Usuário (configuracoes-gestao), sem FK.
  responsavelId          String?             @map("responsavel_id") @db.Uuid
  previsaoFechamento     DateTime?           @map("previsao_fechamento") @db.Date
  origemClienteId        String?             @map("origem_cliente_id") @db.Uuid
  status                 NegocioStatus       @default(ABERTO)
  motivoPerdaId          String?             @map("motivo_perda_id") @db.Uuid
  observacoes            String?
  /// Quando foi marcado como ganho ou perdido.
  fechadoEm              DateTime?           @map("fechado_em") @db.Timestamptz(3)
  /// Datas dos marcos do dashboard: primeira entrada num estágio com o marco.
  marcoPrimeiroContatoEm DateTime?           @map("marco_primeiro_contato_em") @db.Timestamptz(3)
  marcoVisitaEm          DateTime?           @map("marco_visita_em") @db.Timestamptz(3)
  marcoPropostaEm        DateTime?           @map("marco_proposta_em") @db.Timestamptz(3)
  marcoContratoEm        DateTime?           @map("marco_contrato_em") @db.Timestamptz(3)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?           @map("deleted_at") @db.Timestamptz(3)

  pipeline      Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  estagio       EstagioPipeline    @relation(fields: [estagioId], references: [id], onDelete: Restrict)
  origemCliente OrigemCliente?     @relation(fields: [origemClienteId], references: [id], onDelete: Restrict)
  motivoPerda   MotivoPerda?       @relation(fields: [motivoPerdaId], references: [id], onDelete: Restrict)
  atividades    AtividadeNegocio[]

  @@index([pipelineId, status])
  @@index([estagioId])
  @@index([contatoId])
  @@index([origemClienteId])
  @@map("negocios")
}

/// Dono: comercial-atendimento. Atividade do CRM (tela Atividades, `/atividades`): a próxima ação
/// de um negócio ("Agendar Follow-up" do Pipeline) ou uma atividade avulsa, sem negócio.
