// Convenções (CLAUDE.md, seção 3): model PascalCase singular, tabela snake_case plural
// via @@map, colunas snake_case via @map, ids uuid e timestamps com fuso (UTC).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome          String
  /// CNPJ ou CPF, somente dígitos.
  documento     String    @unique
  email         String?
  telefone      String?
  /// Id do Arquivo (common/storage) com o logo. Sem FK: módulos não acessam tabelas um do outro.
  logoArquivoId String?   @map("logo_arquivo_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  unidades              Unidade[]
  usuarios              Usuario[]
  horariosFuncionamento HorarioFuncionamento[]

  @@map("empresas")
}

model Unidade {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String    @map("empresa_id") @db.Uuid
  nome      String
  endereco  String?
  cidade    String?
  uf        String?   @db.VarChar(2)
  telefone  String?
  /// CNPJ, somente dígitos.
  cnpj      String?
  /// Código CNES (Cadastro Nacional de Estabelecimentos de Saúde).
  cnes      String?
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@map("unidades")
}

/// Horário de funcionamento de um dia da semana (aba Horários de Minha Empresa).
model HorarioFuncionamento {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  /// 0 = domingo .. 6 = sábado.
  diaSemana Int      @map("dia_semana")
  fechado   Boolean  @default(false)
  /// Formato "HH:mm". Nulo quando `fechado`.
  abre      String?  @db.VarChar(5)
  fecha     String?  @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  empresa    Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  intervalos HorarioIntervalo[]

  @@unique([empresaId, diaSemana])
  @@map("horarios_funcionamento")
}

/// Pausa (ex.: almoço) dentro do horário de um dia. Um dia pode ter zero ou mais.
model HorarioIntervalo {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  horarioId String @map("horario_id") @db.Uuid
  /// Formato "HH:mm".
  inicio    String @db.VarChar(5)
  fim       String @db.VarChar(5)
  ordem     Int    @default(0)

  horario HorarioFuncionamento @relation(fields: [horarioId], references: [id], onDelete: Cascade)

  @@index([horarioId])
  @@map("horarios_intervalos")
}

/// Usuário do sistema. Sem `senhaHash` não há login (até definir a senha pela redefinição).
model Usuario {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String    @map("empresa_id") @db.Uuid
  perfilId      String?   @map("perfil_id") @db.Uuid
  nome          String
  email         String    @unique
  telefone      String?
  /// Hash argon2id. Nunca sai em resposta, log ou audit_log.
  senhaHash     String?   @map("senha_hash")
  ativo         Boolean   @default(true)
  ultimoLoginEm DateTime? @map("ultimo_login_em") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  empresa      Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  perfil       Perfil?            @relation(fields: [perfilId], references: [id], onDelete: Restrict)
  sessoes      Sessao[]
  redefinicoes RedefinicaoSenha[]
  caixas       Caixa[]

  @@index([empresaId])
  @@index([perfilId])
  @@map("usuarios")
}

/// Perfil de acesso: o conjunto de permissões (`<modulo>.<recurso>.<acao>`) dos seus usuários.
model Perfil {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String    @unique
  descricao String?
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  permissoes PerfilPermissao[]
  usuarios   Usuario[]

  @@map("perfis")
}

/// Permissão concedida a um perfil. O texto é validado pelo catálogo de `packages/shared`.
model PerfilPermissao {
  perfilId  String @map("perfil_id") @db.Uuid
  permissao String

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@id([perfilId, permissao])
  @@map("perfis_permissoes")
}

/// Sessão de login. Guarda só o hash do refresh token atual (rotacionado a cada uso).
model Sessao {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  tokenHash   String    @map("token_hash")
  expiraEm    DateTime  @map("expira_em") @db.Timestamptz(3)
  revogadaEm  DateTime? @map("revogada_em") @db.Timestamptz(3)
  ultimoUsoEm DateTime? @map("ultimo_uso_em") @db.Timestamptz(3)
  ip          String?
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessoes")
}

/// Pedido de redefinição de senha: token de uso único, guardado só como hash.
model RedefinicaoSenha {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiraEm  DateTime  @map("expira_em") @db.Timestamptz(3)
  usadaEm   DateTime? @map("usada_em") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("redefinicoes_senha")
}

// ---------------------------------------------------------------------------------------------
// Entidades compartilhadas (issue #81). Campos mínimos: identificação, status, vínculos e o que
// outras telas consomem. A tela de cada entidade completa os campos dela em migration própria.
// Cada uma pertence ao módulo dono (comentário do model) e é exposta pelo service dele.
// ---------------------------------------------------------------------------------------------

enum PacienteTipo {
  PF
  PJ

  @@map("paciente_tipo")
}

enum PacienteStatus {
  NOVO
  ATIVO
  INATIVO

  @@map("paciente_status")
}

enum PacienteSexo {
  FEMININO
  MASCULINO
  OUTRO

  @@map("paciente_sexo")
}

/// Dono: comercial-atendimento. Paciente/cliente, pessoa física ou jurídica (tela Pacientes, `/clientes`).
model Paciente {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo                    PacienteTipo   @default(PF)
  nome                    String
  nomeSocial              String?        @map("nome_social")
  /// CPF (PF) ou CNPJ (PJ), somente dígitos.
  documento               String?
  rg                      String?
  menorIdade              Boolean        @default(false) @map("menor_idade")
  telefone                String?
  celular                 String?
  email                   String?
  /// Data de nascimento (PF) ou de fundação (PJ).
  dataNascimento          DateTime?      @map("data_nascimento") @db.Date
  sexo                    PacienteSexo?
  profissao               String?
  /// De onde o paciente chegou (tela Origens de Cliente).
  origemClienteId         String?        @map("origem_cliente_id") @db.Uuid
  /// Inativo some dos comboboxes (lookups), mas o cadastro continua consultável.
  status                  PacienteStatus @default(ATIVO)
  observacoes             String?
  /// LGPD: desmarcado quando o paciente pede para não receber campanhas. Confirmações continuam.
  aceitaCampanhasWhatsapp Boolean        @default(true) @map("aceita_campanhas_whatsapp")
  razaoSocial             String?        @map("razao_social")
  nomeFantasia            String?        @map("nome_fantasia")
  inscricaoEstadual       String?        @map("inscricao_estadual")
  representanteNome       String?        @map("representante_nome")
  representanteCelular    String?        @map("representante_celular")
  cep                     String?
  logradouro              String?
  numero                  String?
  complemento             String?
  bairro                  String?
  cidade                  String?
  uf                      String?
  codigoIbge              String?        @map("codigo_ibge")
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?      @map("deleted_at") @db.Timestamptz(3)

  origemCliente OrigemCliente? @relation(fields: [origemClienteId], references: [id], onDelete: Restrict)
  agendamentos  Agendamento[]
  orcamentos    Orcamento[]
  vendas        Venda[]
  contasReceber ContaReceber[]

  @@index([documento])
  @@index([origemClienteId])
  @@index([status])
  @@map("pacientes")
}

/// Dono: comercial-atendimento. De onde os pacientes chegam (cadastro de clientes e relatórios de captação).
model OrigemCliente {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  /// Gerado a partir do nome (`gerarCodigoOrigemCliente`).
  codigo    String
  ordem     Int
  ativa     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  pacientes Paciente[]

  @@index([ordem])
  @@map("origens_cliente")
}

/// Dono: gestao-profissionais.
model Especialidade {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  profissionais Profissional[]

  @@map("especialidades")
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL

  @@map("estado_civil")
}

enum LayoutReceita {
  PADRAO
  COMPACTO
  TIMBRADO
  PERSONALIZADO

  @@map("layout_receita")
}

enum HorarioTipo {
  SEMANAL
  POR_DATA

  @@map("horario_tipo")
}

enum BloqueioTipo {
  DIA_INTEIRO
  HORARIO

  @@map("bloqueio_tipo")
}

enum BloqueioMotivo {
  FERIAS
  FOLGA
  CONGRESSO_CURSO
  ATESTADO_MEDICO
  FERIADO
  REUNIAO
  OUTRO

  @@map("bloqueio_motivo")
}

/// Dono: gestao-profissionais.
model Profissional {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                 String
  /// Registro no conselho (CRM, CRN, CRBM…), texto livre.
  registro             String?
  especialidadeId      String?       @map("especialidade_id") @db.Uuid
  /// Especialidades adicionais separadas por vírgula (usadas pelo agente de IA).
  outrasEspecialidades String?       @map("outras_especialidades")
  telefone             String?
  email                String?
  duracaoPadrao        Int           @default(30) @map("duracao_padrao")
  valorConsulta        Decimal?      @map("valor_consulta") @db.Decimal(12, 2)
  comissao             Decimal?      @db.Decimal(5, 2)
  /// Chave da cor no calendário (catálogo em `packages/shared`).
  corCalendario        String        @default("azul") @map("cor_calendario")
  cpf                  String?
  rg                   String?
  dataNascimento       DateTime?     @map("data_nascimento") @db.Date
  naturalidade         String?
  estadoCivil          EstadoCivil?  @map("estado_civil")
  endereco             String?
  enderecoConsultorio  String?       @map("endereco_consultorio")
  telefoneReceita      String?       @map("telefone_receita")
  cnes                 String?
  rodapeReceita        String?       @map("rodape_receita")
  layoutReceita        LayoutReceita @default(PADRAO) @map("layout_receita")
  /// Credenciais da Memed, cifradas (AES-256-GCM) antes de gravar. A Secret Key nunca sai da API.
  memedApiToken        String?       @map("memed_api_token")
  memedSecretKey       String?       @map("memed_secret_key")
  /// Arquivos enviados em `/api/arquivos` (usos `foto-profissional` e `logo-receita`).
  fotoArquivoId        String?       @map("foto_arquivo_id") @db.Uuid
  logoReceitaArquivoId String?       @map("logo_receita_arquivo_id") @db.Uuid
  ativo                Boolean       @default(true)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(3)

  especialidade Especialidade?        @relation(fields: [especialidadeId], references: [id], onDelete: Restrict)
  horarios      HorarioAtendimento[]
  bloqueios     BloqueioAgenda[]
  servicos      ServicoProfissional[]
  contratosSala ContratoSala[]
  agendamentos  Agendamento[]
  protocolos    Protocolo[]

  @@index([especialidadeId])
  @@map("profissionais")
}

/// Dono: gestao-profissionais. Horário semanal (`dia_semana`, 0 = domingo) ou de uma data.
model HorarioAtendimento {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profissionalId String      @map("profissional_id") @db.Uuid
  tipo           HorarioTipo
  diaSemana      Int?        @map("dia_semana")
  data           DateTime?   @db.Date
  /// "HH:MM".
  inicio         String
  fim            String
  almocoInicio   String?     @map("almoco_inicio")
  almocoFim      String?     @map("almoco_fim")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId])
  @@map("horarios_atendimento")
}

/// Dono: gestao-profissionais. Período em que o profissional não atende (dia inteiro ou horário).
model BloqueioAgenda {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profissionalId String         @map("profissional_id") @db.Uuid
  dataInicio     DateTime       @map("data_inicio") @db.Date
  dataFim        DateTime       @map("data_fim") @db.Date
  tipo           BloqueioTipo
  /// "HH:MM", só no bloqueio por horário.
  horaInicio     String?        @map("hora_inicio")
  horaFim        String?        @map("hora_fim")
  motivo         BloqueioMotivo
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId, dataFim])
  @@map("bloqueios_agenda")
}

/// Dono: compras-estoque.
model Fornecedor {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String
  nomeFantasia String?   @map("nome_fantasia")
  /// CNPJ ou CPF, somente dígitos.
  documento    String?
  email        String?
  contato      String?
  telefone     String?
  celular      String?
  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  /// Sigla do estado.
  uf           String?   @db.Char(2)
  ativo        Boolean   @default(true)
  observacoes  String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  compras Compra[]

  @@index([documento])
  @@map("fornecedores")
}

enum TipoItem {
  PRODUTO
  SERVICO

  @@map("tipo_item")
}

/// Dono: compras-estoque. Categoria de produtos ou de serviços.
model Categoria {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  tipo      TipoItem
  /// Cor de exibição, ex.: `#22c55e`.
  cor       String?
  descricao String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  produtos Produto[]

  @@map("categorias")
}

/// Dono: compras-estoque. Ex.: UN (Unidade), CX (Caixa).
model UnidadeMedida {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sigla     String
  nome      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  produtos Produto[]

  @@map("unidades_medida")
}

/// Tipo do item do catálogo (campo Tipo do modal Novo Produto/Serviço). Só `SERVICO` é serviço.
enum ProdutoTipo {
  PRODUTO
  REVENDA
  USO_CONSUMO
  SERVICO

  @@map("produto_tipo")
}

/// Dono: compras-estoque. Produto ou serviço do catálogo da clínica.
model Produto {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome            String
  tipo            ProdutoTipo
  categoriaId     String?     @map("categoria_id") @db.Uuid
  unidadeMedidaId String?     @map("unidade_medida_id") @db.Uuid
  marca           String?
  codigoBarras    String?     @map("codigo_barras")
  sku             String?
  precoCusto      Decimal?    @map("preco_custo") @db.Decimal(12, 2)
  precoVenda      Decimal     @default(0) @map("preco_venda") @db.Decimal(12, 2)
  estoqueMinimo   Decimal     @default(0) @map("estoque_minimo") @db.Decimal(12, 3)
  controlaEstoque Boolean     @default(true) @map("controla_estoque")
  /// Saldo atual. Só leitura em Produtos/Serviços: a tela Estoque (#20) é quem movimenta.
  estoqueAtual    Decimal     @default(0) @map("estoque_atual") @db.Decimal(12, 3)
  ncm             String?
  descricao       String?
  ativo           Boolean     @default(true)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(3)

  categoria     Categoria?     @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  unidadeMedida UnidadeMedida? @relation(fields: [unidadeMedidaId], references: [id], onDelete: Restrict)

  protocoloItens ProtocoloItem[]
  compraItens    CompraItem[]

  @@index([categoriaId])
  @@index([unidadeMedidaId])
  @@index([sku])
  @@index([codigoBarras])
  @@map("produtos")
}

enum CompraStatus {
  PENDENTE
  RECEBIDA
  CANCELADA

  @@map("compra_status")
}

/// Dono: compras-estoque. Entrada de compras (tela `/compras`). Registrar a compra como
/// RECEBIDA soma os itens em `Produto.estoqueAtual`; cancelar ou excluir desfaz a entrada.
/// O fornecedor é validado pelo service do módulo, mas tem FK (mesmo módulo). Exclusão lógica.
model Compra {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Número exibido na coluna "#".
  numero       Int          @unique @default(autoincrement())
  fornecedorId String       @map("fornecedor_id") @db.Uuid
  numeroNf     String?      @map("numero_nf")
  serieNf      String?      @map("serie_nf")
  dataEmissao  DateTime?    @map("data_emissao") @db.Date
  dataEntrada  DateTime     @map("data_entrada") @db.Date
  frete        Decimal      @default(0) @db.Decimal(12, 2)
  desconto     Decimal      @default(0) @db.Decimal(12, 2)
  valorTotal   Decimal      @map("valor_total") @db.Decimal(12, 2)
  status       CompraStatus @default(RECEBIDA)
  observacoes  String?
  /// Arquivo da NF (PDF ou imagem) em `arquivos`, sem FK.
  arquivoNfId  String?      @map("arquivo_nf_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)

  fornecedor Fornecedor   @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  itens      CompraItem[]

  @@index([fornecedorId])
  @@index([status])
  @@index([dataEntrada])
  @@map("compras")
}

/// Dono: compras-estoque. Item da compra. `planoContaId` é a "Conta contábil (opcional)" (Plano
/// de Contas do Financeiro, sem FK: o acesso é pelo service do módulo dono).
model CompraItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compraId      String   @map("compra_id") @db.Uuid
  produtoId     String   @map("produto_id") @db.Uuid
  descricao     String
  quantidade    Decimal  @db.Decimal(12, 3)
