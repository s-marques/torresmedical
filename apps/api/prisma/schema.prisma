enum CaixaStatus {
  ABERTO
  FECHADO
}

/// Dono: financeiro. Caixa aberto por um operador (tela Caixas, `/caixas`).
model Caixa {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Número exibido na coluna "#".
  numero          Int         @unique @default(autoincrement())
  nome            String
  operadorId      String      @map("operador_id") @db.Uuid
  dataAbertura    DateTime    @default(now()) @map("data_abertura") @db.Timestamptz(3)
  dataFechamento  DateTime?   @map("data_fechamento") @db.Timestamptz(3)
