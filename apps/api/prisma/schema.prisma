  profissionalId String       @map("profissional_id") @db.Uuid
  nome           String
  categoria      String?
  valor          Decimal      @default(0) @db.Decimal(12, 2)
  duracaoMinutos Int          @default(30) @map("duracao_minutos")
  descricao      String?
  ativo          Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  profissional   Profissional @relation(fields: [profissionalId], references: [id])

  @@index([profissionalId])
  @@map("servicos_profissionais")
}

/// Dono: gestao-profissionais. Tipo do protocolo (select "Tipo" do modal Novo Protocolo).
enum ProtocoloTipo {
  PROCEDIMENTO
  PRODUTO

  @@map("protocolo_tipo")
}

/// Dono: gestao-profissionais. Conjunto de procedimentos/produtos aplicado no atendimento (tela
/// Protocolos). O nome é único entre os não excluídos, sem diferenciar maiúsculas (service).
model Protocolo {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome           String
  tipo           ProtocoloTipo @default(PROCEDIMENTO)
  categoria      String        @default("Geral")
  profissionalId String?       @map("profissional_id") @db.Uuid
  totalSemanas   Int           @default(1) @map("total_semanas")
  valorTotal     Decimal       @default(0) @map("valor_total") @db.Decimal(12, 2)
  observacoes    String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  profissional Profissional?        @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  itens        ProtocoloItem[]
  semanasMae   ProtocoloMaeSemana[]

  @@index([profissionalId])
  @@index([categoria])
  @@map("protocolos")
}

/// Dono: gestao-profissionais. Item da composição de um protocolo (produto/serviço e quantidade).
model ProtocoloItem {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocoloId String @map("protocolo_id") @db.Uuid
  produtoId   String @map("produto_id") @db.Uuid
  quantidade  Int    @default(1)

  protocolo Protocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  produto   Produto   @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@unique([protocoloId, produtoId])
  @@index([produtoId])
  @@map("protocolo_itens")
}

/// Dono: gestao-profissionais. Protocolo mãe: sequência de protocolos, um por semana.
model ProtocoloMae {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String
  categoria    String    @default("Geral")
  totalSemanas Int       @default(1) @map("total_semanas")
  valorTotal   Decimal   @default(0) @map("valor_total") @db.Decimal(12, 2)
  descricao    String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  semanas ProtocoloMaeSemana[]

  @@index([categoria])
  @@map("protocolos_mae")
}

/// Dono: gestao-profissionais. Semana de um protocolo mãe (protocolo opcional e observações).
model ProtocoloMaeSemana {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocoloMaeId String  @map("protocolo_mae_id") @db.Uuid
  semana         Int
  protocoloId    String? @map("protocolo_id") @db.Uuid
  observacoes    String?

  protocoloMae ProtocoloMae @relation(fields: [protocoloMaeId], references: [id], onDelete: Cascade)
  protocolo    Protocolo?   @relation(fields: [protocoloId], references: [id], onDelete: Restrict)

  @@unique([protocoloMaeId, semana])
  @@index([protocoloId])
  @@map("protocolo_mae_semanas")
}

/// Dono: gestao-profissionais. Tipo da sala (select "Tipo" da tela Salas).
enum SalaTipo {
  CONSULTORIO
  PROCEDIMENTO
  EXAME
  REUNIAO
  OUTRO

  @@map("sala_tipo")
}

/// Dono: gestao-profissionais. Sala alugada a profissionais (tela Salas). Exclusão lógica: os
/// contratos e cobranças futuros continuam apontando para ela.
model Sala {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String
  numero       String?
  andar        String?
  tipo         SalaTipo  @default(CONSULTORIO)
  capacidade   Int       @default(1)
  metragem     Decimal?  @db.Decimal(8, 2)
  valorHora    Decimal?  @map("valor_hora") @db.Decimal(12, 2)
  valorTurno   Decimal?  @map("valor_turno") @db.Decimal(12, 2)
  valorMensal  Decimal?  @map("valor_mensal") @db.Decimal(12, 2)
  equipamentos String?
  ativo        Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  contratos ContratoSala[]

  @@map("salas")
}

/// Dono: gestao-profissionais. Modalidade do contrato de aluguel de sala.
enum ContratoSalaModalidade {
  MENSAL
  TURNO
  HORA

  @@map("contrato_sala_modalidade")
}

/// Dono: gestao-profissionais. Quem aluga a sala: um profissional ou um cliente (paciente).
enum ContratoSalaLocatarioTipo {
  PROFISSIONAL
  CLIENTE

  @@map("contrato_sala_locatario_tipo")
}

enum ContratoSalaTipoReceita {
  FIXO
  VARIAVEL
  MISTO

  @@map("contrato_sala_tipo_receita")
}

enum ContratoSalaIndiceReajuste {
  NENHUM
  IGPM
  IPCA
  INPC
  LIVRE_NEGOCIACAO

  @@map("contrato_sala_indice_reajuste")
}

/// A ordem dos valores é a da listagem (ativos primeiro).
enum ContratoSalaStatus {
  ATIVO
  CANCELADO
  ENCERRADO

  @@map("contrato_sala_status")
}

/// Dono: gestao-profissionais. Contrato de aluguel de sala (aba Contratos da tela Salas).
/// `valor_unitario` é o valor mensal, por turno ou por hora, conforme a modalidade;
/// `quantidade_mensal` são os turnos/horas contratados por mês. O locatário é o profissional
/// ou o paciente (módulo comercial-atendimento, sem FK: o acesso é pelo service exportado).
/// Exclusão lógica, pois cobranças futuras apontam para o contrato.
model ContratoSala {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salaId             String                     @map("sala_id") @db.Uuid
  modalidade         ContratoSalaModalidade
  locatarioTipo      ContratoSalaLocatarioTipo  @map("locatario_tipo")
  profissionalId     String?                    @map("profissional_id") @db.Uuid
  pacienteId         String?                    @map("paciente_id") @db.Uuid
  especialidade      String?
  valorUnitario      Decimal                    @default(0) @map("valor_unitario") @db.Decimal(12, 2)
  quantidadeMensal   Decimal?                   @map("quantidade_mensal") @db.Decimal(8, 2)
  permuta            Boolean                    @default(false)
  tipoReceita        ContratoSalaTipoReceita    @default(FIXO) @map("tipo_receita")
  diaVencimento      Int                        @default(10) @map("dia_vencimento")
  /// Forma de pagamento (módulo financeiro, sem FK).
  formaPagamentoId   String?                    @map("forma_pagamento_id") @db.Uuid
  indiceReajuste     ContratoSalaIndiceReajuste @default(NENHUM) @map("indice_reajuste")
  dataInicio         DateTime                   @map("data_inicio") @db.Date
  dataFim            DateTime?                  @map("data_fim") @db.Date
  permiteIndicacao   Boolean                    @default(true) @map("permite_indicacao")
  participaEventos   Boolean                    @default(false) @map("participa_eventos")
  observacoes        String?
  status             ContratoSalaStatus         @default(ATIVO)
  /// Data do encerramento (término natural) ou do cancelamento (rescisão); nula enquanto ativo.
  encerradoEm        DateTime?                  @map("encerrado_em") @db.Date
  /// Observação do encerramento ou motivo da rescisão.
  motivoEncerramento String?                    @map("motivo_encerramento")
  /// PDF do contrato enviado em `/api/arquivos` (uso `contrato-sala`).
  pdfArquivoId       String?                    @map("pdf_arquivo_id") @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?                  @map("deleted_at") @db.Timestamptz(3)

  sala         Sala               @relation(fields: [salaId], references: [id])
  profissional Profissional?      @relation(fields: [profissionalId], references: [id])
  dias         ContratoSalaDia[]
  horas        ContratoSalaHora[]

  @@index([salaId])
  @@index([profissionalId])
  @@index([pacienteId])
  @@index([status])
  @@map("contratos_sala")
}

/// Dia da semana (0 = domingo) e horário "HH:MM" em que o locatário usa a sala.
model ContratoSalaDia {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contratoId String @map("contrato_id") @db.Uuid
  diaSemana  Int    @map("dia_semana")
  inicio     String
  fim        String

  contrato ContratoSala @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, diaSemana])
  @@map("contratos_sala_dias")
}

/// Hora utilizada de um contrato de Hora Avulsa (modal "Horas Utilizadas"): data e horário
/// "HH:MM" de entrada e saída. Base da cobrança do mês.
model ContratoSalaHora {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contratoId String   @map("contrato_id") @db.Uuid
  data       DateTime @db.Date
  entrada    String
  saida      String
  observacao String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contrato ContratoSala @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([contratoId, data])
  @@map("contratos_sala_horas")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  EXPORT

  @@map("audit_action")
}

/// Somente inserção (CLAUDE.md, seção 4). Sem FK em user_id: aceita "system".
model AuditLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String      @map("user_id")
  occurredAt DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  action     AuditAction
  entity     String
  entityId   String      @map("entity_id")
  before     Json?
  after      Json?
  requestId  String?     @map("request_id")
  ip         String?

  @@index([entity, entityId])
  @@index([occurredAt])
  @@index([userId])
  @@map("audit_log")
}

/// Metadados dos arquivos enviados. O conteúdo fica no storage (S3/MinIO ou disco), sob `chave`.
/// `uso` é validado pelo catálogo de `packages/shared`. Sem FK em criado_por: aceita "system".
model Arquivo {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uso          String
  nomeOriginal String    @map("nome_original")
  contentType  String    @map("content_type")
  /// Tamanho em bytes.
  tamanho      Int
  chave        String    @unique
  criadoPor    String?   @map("criado_por")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([uso])
  @@map("arquivos")
}

// Mensageria (CLAUDE.md, seção 5). Tabelas técnicas, fora dos módulos do inventário.

/// Outbox: eventos gravados na mesma transação da escrita que os gerou. O relay publica no
/// RabbitMQ só o que foi commitado e apaga a linha depois da confirmação do broker.
model OutboxEvent {
  /// É o `eventId` do envelope.
  id        String   @id @db.Uuid
  /// Routing key (`<modulo>.<entidade>.<acao>`). O exchange é `torres.<modulo>`.
  type      String
  /// Envelope completo `{ eventId, type, occurredAt, userId, payload, version }`.
  envelope  Json
  /// Tentativas de publicação que falharam.
  attempts  Int      @default(0)
  /// Tipo do último erro de publicação (sem mensagem: pode conter dados).
  lastError String?  @map("last_error")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("outbox_events")
}

/// Eventos já processados por consumidor (fila). Garante a idempotência por `eventId`.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  /// Nome da fila consumidora: um mesmo evento é processado uma vez por fila.
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, consumer])
  @@index([processedAt])
  @@map("processed_events")
}

/// Dono: comercial-atendimento. Situação do orçamento (chips da tela Orçamentos).
enum OrcamentoStatus {
  PENDENTE
  APROVADO
  CONCLUIDO
  CANCELADO

  @@map("orcamento_status")
}

enum OrcamentoDescontoTipo {
  VALOR
  PERCENTUAL

  @@map("orcamento_desconto_tipo")
}

enum OrcamentoItemOrigem {
  SERVICO
  PROTOCOLO
  PROTOCOLO_MAE

  @@map("orcamento_item_origem")
}

/// Dono: comercial-atendimento. Orçamento do paciente (tela Orçamentos, `/orcamentos`). Os totais
/// são calculados pelo service. Exclusão lógica: histórico comercial.
model Orcamento {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Número exibido na coluna "#".
  numero           Int                   @unique @default(autoincrement())
  /// Opcional: o modal permite criar sem cliente.
  pacienteId       String?               @map("paciente_id") @db.Uuid
  formaPagamentoId String?               @map("forma_pagamento_id") @db.Uuid
  observacoes      String?
  descontoTipo     OrcamentoDescontoTipo @default(VALOR) @map("desconto_tipo")
  /// R$ ou %, conforme `descontoTipo`.
  descontoValor    Decimal               @default(0) @map("desconto_valor") @db.Decimal(12, 2)
  subtotal         Decimal               @db.Decimal(12, 2)
  total            Decimal               @db.Decimal(12, 2)
  status           OrcamentoStatus       @default(PENDENTE)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?             @map("deleted_at") @db.Timestamptz(3)

  paciente       Paciente?       @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
  itens          OrcamentoItem[]

  @@index([pacienteId])
  @@index([status])
  @@index([createdAt])
  @@map("orcamentos")
}

/// Dono: comercial-atendimento. Item do orçamento: descrição e preços ficam copiados (snapshot),
/// para o orçamento não mudar quando o cadastro de origem for alterado.
model OrcamentoItem {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orcamentoId   String              @map("orcamento_id") @db.Uuid
  origem        OrcamentoItemOrigem
  /// Serviço, protocolo ou protocolo mãe de origem (sem FK: o item é um snapshot).
  origemId      String              @map("origem_id") @db.Uuid
  descricao     String
  quantidade    Int                 @default(1)
  valorUnitario Decimal             @map("valor_unitario") @db.Decimal(12, 2)
  /// Desconto do item em R$.
  desconto      Decimal             @default(0) @db.Decimal(12, 2)
  total         Decimal             @db.Decimal(12, 2)
  posicao       Int                 @default(0)

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([orcamentoId])
  @@map("orcamento_itens")
}

enum VendaStatus {
  ORCAMENTO_APROVADO
  FINALIZADA
  CANCELADA

  @@map("venda_status")
}

enum VendaItemOrigem {
  PRODUTO
  PROTOCOLO

  @@map("venda_item_origem")
}

/// Dono: comercial-atendimento. Venda do PDV (aba "Vendas (PDV)" da tela Vendas/PDV, `/vendas`). Os
/// totais são calculados pelo service. Exclusão lógica: histórico financeiro.
model Venda {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Número exibido na coluna "#".
  numero           Int         @unique @default(autoincrement())
  /// Opcional: o PDV permite vender sem cliente ("Cliente (opcional)").
  pacienteId       String?     @map("paciente_id") @db.Uuid
  formaPagamentoId String?     @map("forma_pagamento_id") @db.Uuid
  parcelas         Int         @default(1)
  /// Desconto geral em R$ (campo "Desconto (R$)").
  desconto         Decimal     @default(0) @db.Decimal(12, 2)
  subtotal         Decimal     @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  status           VendaStatus @default(FINALIZADA)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3)

  paciente       Paciente?       @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
  itens          VendaItem[]

  @@index([pacienteId])
  @@index([formaPagamentoId])
  @@index([status])
  @@index([createdAt])
  @@map("vendas")
}

/// Dono: comercial-atendimento. Item da venda: descrição e preço ficam copiados (snapshot).
model VendaItem {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendaId       String          @map("venda_id") @db.Uuid
  origem        VendaItemOrigem
  /// Produto/serviço ou protocolo de origem (sem FK: o item é um snapshot).
  origemId      String          @map("origem_id") @db.Uuid
  descricao     String
  quantidade    Int             @default(1)
  valorUnitario Decimal         @map("valor_unitario") @db.Decimal(12, 2)
  total         Decimal         @db.Decimal(12, 2)
  posicao       Int             @default(0)

  venda Venda @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@index([vendaId])
  @@map("venda_itens")
}

enum PlanoContaTipo {
  RECEITA
  DESPESA
  ATIVO
  PASSIVO
}

/// Dono: financeiro. Conta contábil em árvore (tela Plano de Contas, `/plano-contas`).
model PlanoConta {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo     String         @unique
  nome       String
  tipo       PlanoContaTipo
  /// 1 para raiz; nível do pai + 1 nas demais.
  nivel      Int            @default(1)
  contaPaiId String?        @map("conta_pai_id") @db.Uuid
  ativo      Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?      @map("deleted_at") @db.Timestamptz(3)

  contaPai      PlanoConta?    @relation("PlanoContaHierarquia", fields: [contaPaiId], references: [id], onDelete: Restrict)
  filhas        PlanoConta[]   @relation("PlanoContaHierarquia")
  contasPagar   ContaPagar[]
  contasReceber ContaReceber[]

  @@index([contaPaiId])
  @@map("planos_contas")
}

/// "Vencido" não é gravado: é calculado (PENDENTE com dataVencimento no passado), conforme
/// o sistema real (print do dev, issue #48).
enum ContaReceberStatus {
  PENDENTE
  RECEBIDO
  CANCELADO

  @@map("conta_receber_status")
}

/// Dono: financeiro. Conta a receber (tela Contas a Receber, `/receber`). Exclusão lógica:
/// histórico financeiro.
model ContaReceber {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Número exibido na coluna "#".
  numero           Int                @unique @default(autoincrement())
  descricao        String
  /// Opcional: o modal permite cadastrar sem cliente ("Buscar cliente (nome, telefone)...").
  pacienteId       String?            @map("paciente_id") @db.Uuid
  valor            Decimal            @db.Decimal(12, 2)
  dataVencimento   DateTime           @map("data_vencimento") @db.Date
  formaPagamentoId String?            @map("forma_pagamento_id") @db.Uuid
  planoContaId     String?            @map("plano_conta_id") @db.Uuid
  documento        String?
  totalParcelas    Int                @default(1) @map("total_parcelas")
  status           ContaReceberStatus @default(PENDENTE)
  observacoes      String?
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(3)

  paciente       Paciente?       @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
  planoConta     PlanoConta?     @relation(fields: [planoContaId], references: [id], onDelete: Restrict)

  @@index([pacienteId])
  @@index([formaPagamentoId])
  @@index([planoContaId])
  @@index([status])
  @@index([dataVencimento])
  @@map("contas_receber")
}

/// Dono: financeiro. Conta bancária usada nas baixas de Contas a Pagar. Ainda sem tela de
/// cadastro própria (issue #47); cadastrada via seed/admin por enquanto.
model ContaBancaria {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  banco     String?
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  baixas ContaPagarBaixa[]

  @@map("contas_bancarias")
}

enum ContaPagarBeneficiarioTipo {
  FORNECEDOR
  FUNCIONARIO

  @@map("conta_pagar_beneficiario_tipo")
}

enum ContaPagarStatus {
  PENDENTE
  PAGO
  CANCELADO

  @@map("conta_pagar_status")
}

/// Dono: financeiro. Conta a pagar (tela Contas a Pagar, `/pagar`). O beneficiário é um
/// Fornecedor (compras-estoque) ou um Funcionário (regulatorio-qualidade), sem FK: o acesso é
/// pelos services exportados de cada módulo (CLAUDE.md, seção 3). Exclusão lógica: histórico
/// financeiro.
model ContaPagar {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Número exibido na coluna "#".
  numero           Int                        @unique @default(autoincrement())
  descricao        String
  beneficiarioTipo ContaPagarBeneficiarioTipo @default(FORNECEDOR) @map("beneficiario_tipo")
  /// Preenchido quando beneficiarioTipo = FORNECEDOR (sem FK).
  fornecedorId     String?                    @map("fornecedor_id") @db.Uuid
  /// Preenchido quando beneficiarioTipo = FUNCIONARIO (sem FK).
  funcionarioId    String?                    @map("funcionario_id") @db.Uuid
  valor            Decimal                    @db.Decimal(12, 2)
  dataVencimento   DateTime                   @map("data_vencimento") @db.Date
  formaPagamentoId String?                    @map("forma_pagamento_id") @db.Uuid
  planoContaId     String?                    @map("plano_conta_id") @db.Uuid
  documento        String?
  totalParcelas    Int                        @default(1) @map("total_parcelas")
  status           ContaPagarStatus           @default(PENDENTE)
  observacoes      String?
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?                  @map("deleted_at") @db.Timestamptz(3)

  formaPagamento FormaPagamento?   @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
  planoConta     PlanoConta?       @relation(fields: [planoContaId], references: [id], onDelete: Restrict)
  baixas         ContaPagarBaixa[]

  @@index([fornecedorId])
  @@index([funcionarioId])
  @@index([formaPagamentoId])
  @@index([planoContaId])
  @@index([status])
  @@index([dataVencimento])
  @@map("contas_pagar")
}

/// Dono: financeiro. Baixa (pagamento total ou parcial) de uma conta a pagar. "Cancelar Baixa"
/// exclui logicamente a baixa mais recente, sem apagar o histórico, e recalcula o status.
model ContaPagarBaixa {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contaPagarId         String    @map("conta_pagar_id") @db.Uuid
  dataPagamento        DateTime  @map("data_pagamento") @db.Date
  valorPago            Decimal   @map("valor_pago") @db.Decimal(12, 2)
  juros                Decimal   @default(0) @db.Decimal(12, 2)
  desconto             Decimal   @default(0) @db.Decimal(12, 2)
  formaPagamentoId     String?   @map("forma_pagamento_id") @db.Uuid
  contaBancariaId      String?   @map("conta_bancaria_id") @db.Uuid
  documento            String?
  observacoes          String?
  /// Arquivo enviado em `/api/arquivos` (uso `comprovante-conta-pagar`), sem FK.
  comprovanteArquivoId String?   @map("comprovante_arquivo_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  contaPagar     ContaPagar      @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
  contaBancaria  ContaBancaria?  @relation(fields: [contaBancariaId], references: [id], onDelete: Restrict)

  @@index([contaPagarId])
  @@map("contas_pagar_baixas")
}
