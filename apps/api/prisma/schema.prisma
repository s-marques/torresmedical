/// Dono: comercial-atendimento. Pesquisa NPS (tela `/pesquisa-satisfacao`): enviada pelo WhatsApp
/// quando o atendimento é finalizado (evento `consultorio.atendimento.finalizado`) e respondida
/// com uma nota de 0 a 10. Uma por atendimento (garante que o envio não se repete).
model PesquisaNps {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Atendimento (consultorio-assistencial) que originou a pesquisa, sem FK.
  atendimentoId      String            @unique @map("atendimento_id") @db.Uuid
  pacienteId         String            @map("paciente_id") @db.Uuid
  profissionalId     String            @map("profissional_id") @db.Uuid
  status             PesquisaNpsStatus
  /// Motivo da falha (sem dados pessoais), ex.: SEM_CANAL, SEM_CELULAR.
  erro               String?
  /// 0 a 10; vazio até o paciente responder.
  nota               Int?
  comentario         String?
  mensagemWhatsappId String?           @unique @map("mensagem_whatsapp_id") @db.Uuid
  enviadaEm          DateTime          @default(now()) @map("enviada_em") @db.Timestamptz(3)
  respondidaEm       DateTime?         @map("respondida_em") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  paciente         Paciente          @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  profissional     Profissional      @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  mensagemWhatsapp MensagemWhatsapp? @relation(fields: [mensagemWhatsappId], references: [id], onDelete: SetNull)

  @@index([enviadaEm])
  @@index([pacienteId, status])
  @@map("pesquisas_nps")
}

/// Telefone que o agente de IA não responde: as mensagens vão direto para a fila de atendentes.
model BypassAgente {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Só dígitos, com DDI. Único entre os não excluídos; a regra fica no service.
  telefone  String
  nome      String?
  cargo     String?
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([telefone])
  @@map("bypass_agentes")
}

/// Dono: consultorio-assistencial. Tipo do receituário controlado (ANVISA): Amarela (A), Azul (B)
/// e Branca (C).
enum ReceituarioTipo {
  AMARELA
  AZUL
  BRANCA

  @@map("receituario_tipo")
}

enum ReceituarioBlocoStatus {
  ATIVO
  FINALIZADO
  CANCELADO

  @@map("receituario_bloco_status")
}

/// Dono: consultorio-assistencial. Bloco (talão) de receituário controlado (aba Blocos da tela
/// Receituários, `/receituarios`, issue #42). Nasce Ativo e vira Finalizado quando todas as
/// folhas são usadas. Exclusão lógica.
model ReceituarioBloco {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo            ReceituarioTipo
  numeroInicio    Int                    @map("numero_inicio")
  numeroFim       Int                    @map("numero_fim")
  localizacao     String?
  /// Médico do bloco (gestao-profissionais), sem FK. Sem médico, o bloco não serve para prescrever.
  profissionalId  String?                @map("profissional_id") @db.Uuid
  dataRecebimento DateTime?              @map("data_recebimento") @db.Date
  /// Folhas já usadas: a próxima prescrição recebe `numero_inicio + usados`.
  usados          Int                    @default(0)
  status          ReceituarioBlocoStatus @default(ATIVO)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?              @map("deleted_at") @db.Timestamptz(3)

  prescricoes Prescricao[]

  @@index([tipo, numeroInicio])
  @@index([profissionalId])
  @@map("receituario_blocos")
}

/// Dono: consultorio-assistencial. Prescrição em receituário controlado (aba Prescricoes da tela
/// Receituários, issue #42). Usa a próxima folha do bloco; o médico é o do bloco. Aparece na aba
/// Receitas e no Histórico Clínico do Prontuário. Sem edição nem exclusão pela tela.
model Prescricao {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blocoId        String    @map("bloco_id") @db.Uuid
  /// Folha do bloco (coluna "N Receita").
  numero         Int
  /// Paciente (comercial-atendimento), sem FK.
  pacienteId     String    @map("paciente_id") @db.Uuid
  /// Médico do bloco no momento da prescrição (gestao-profissionais), sem FK.
  profissionalId String    @map("profissional_id") @db.Uuid
  /// Atendimento de origem, quando houver. A Nova Prescricao da tela não informa.
  atendimentoId  String?   @map("atendimento_id") @db.Uuid
  medicacao      String
  posologia      String?
  dataPrescricao DateTime  @map("data_prescricao") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  bloco       ReceituarioBloco @relation(fields: [blocoId], references: [id], onDelete: Restrict)
  atendimento Atendimento?     @relation(fields: [atendimentoId], references: [id], onDelete: Restrict)

  @@unique([blocoId, numero])
  @@index([pacienteId])
  @@index([profissionalId])
  @@index([dataPrescricao])
  @@map("prescricoes")
}

/// Dono: consultorio-assistencial. Categoria do prestador (filtro "Todas categorias" e aba Serviço).
enum PrestadorCategoria {
  ELETRICA
  HIDRAULICA
  PINTURA
  AR_CONDICIONADO
  JARDINAGEM
  SERRALHERIA
  MARCENARIA
  GESSO
  DEDETIZACAO
  LIMPEZA_CAIXA
  TI
  REFRIGERACAO
  OUTROS

  @@map("prestador_categoria")
}

enum PrestadorStatus {
  ATIVO
  INATIVO
  BLOQUEADO

  @@map("prestador_status")
}

enum PrestadorTipoPessoa {
  FISICA
  JURIDICA

  @@map("prestador_tipo_pessoa")
}

enum PrestadorFormaPagamento {
  PIX
  TRANSFERENCIA
  BOLETO
  DINHEIRO
  CARTAO

  @@map("prestador_forma_pagamento")
}

enum PrestadorAvaliacaoPreco {
  BARATO
  JUSTO
  CARO

  @@map("prestador_avaliacao_preco")
}

/// Dono: consultorio-assistencial. Prestador de serviço de manutenção (tela Prestadores,
/// `/prestadores`, issue #40). Abas do modal: Dados, Serviço, Comercial e Avaliação.
/// Exclusão lógica.
model Prestador {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome             String
  nomeFantasia     String?                 @map("nome_fantasia")
  tipoPessoa       PrestadorTipoPessoa     @default(FISICA) @map("tipo_pessoa")
  /// CPF ou CNPJ, somente dígitos.
  documento        String?
  telefone         String?
  email            String?
  status           PrestadorStatus         @default(ATIVO)
  endereco         String?
  categoria        PrestadorCategoria      @default(ELETRICA)
  descricaoServico String?                 @map("descricao_servico")
  atendeUrgencia   Boolean                 @default(false) @map("atende_urgencia")
  atendeFimSemana  Boolean                 @default(false) @map("atende_fim_semana")
  formaPagamento   PrestadorFormaPagamento @default(PIX) @map("forma_pagamento")
  /// Só preenchida quando a forma de pagamento é PIX.
  chavePix         String?                 @map("chave_pix")
  valorHora        Decimal?                @map("valor_hora") @db.Decimal(12, 2)
  valorDiaria      Decimal?                @map("valor_diaria") @db.Decimal(12, 2)
  emiteNotaFiscal  Boolean                 @default(false) @map("emite_nota_fiscal")
  /// Qualidade do Serviço, de 1 a 5 (coluna Avaliação do grid).
  notaQualidade    Int                     @default(3) @map("nota_qualidade") @db.SmallInt
  /// Pontualidade, de 1 a 5.
  notaPontualidade Int                     @default(3) @map("nota_pontualidade") @db.SmallInt
  avaliacaoPreco   PrestadorAvaliacaoPreco @default(JUSTO) @map("avaliacao_preco")
  observacoes      String?
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamptz(3)

  @@index([categoria])
  @@index([documento])
  @@map("prestadores")
}
