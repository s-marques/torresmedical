/// Dono: comercial-atendimento. Envio em massa agendado pelo WhatsApp (tela Campanhas, aba
/// Envios Agendados). Exclusão lógica: histórico de comunicação.
model Campanha {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome              String
  tipoEnvio         CampanhaTipoEnvio @default(TEXTO) @map("tipo_envio")
  canalId           String            @map("canal_id") @db.Uuid
  filtro            CampanhaFiltro    @default(TODOS)
  origemClienteId   String?           @map("origem_cliente_id") @db.Uuid
  diasCompra        Int?              @map("dias_compra")
  /// Vazio = todos os destinatários do filtro.
  quantidade        Int?
  intervaloSegundos Int               @default(5) @map("intervalo_segundos")
  agendadaPara      DateTime          @map("agendada_para") @db.Timestamptz(3)
  mensagem          String
  status            CampanhaStatus    @default(AGENDADA)
  iniciadaEm        DateTime?         @map("iniciada_em") @db.Timestamptz(3)
  concluidaEm       DateTime?         @map("concluida_em") @db.Timestamptz(3)
  canceladaEm       DateTime?         @map("cancelada_em") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(3)

  canal         CanalWhatsapp   @relation(fields: [canalId], references: [id], onDelete: Restrict)
  origemCliente OrigemCliente?  @relation(fields: [origemClienteId], references: [id], onDelete: Restrict)
  envios        EnvioCampanha[]

  @@index([status, agendadaPara])
  @@map("campanhas")
}

/// Dono: comercial-atendimento. Mensagem recorrente (tela Campanhas, aba Mensagens Automáticas),
/// enviada nos dias e no horário escolhidos. Exclusão lógica.
model MensagemAutomatica {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome              String
  tipoEnvio         CampanhaTipoEnvio @default(TEXTO) @map("tipo_envio")
  canalId           String            @map("canal_id") @db.Uuid
  filtro            CampanhaFiltro    @default(TODOS)
  origemClienteId   String?           @map("origem_cliente_id") @db.Uuid
  diasCompra        Int?              @map("dias_compra")
  /// "HH:MM" no fuso da clínica.
  horario           String
  /// 0 = domingo … 6 = sábado.
  diasSemana        Int[]             @map("dias_semana")
  mensagem          String
  ativa             Boolean           @default(true)
  /// Último dia (fuso da clínica) em que a automação foi disparada: evita disparo duplo.
  ultimaExecucaoDia DateTime?         @map("ultima_execucao_dia") @db.Date
  ultimoEnvioEm     DateTime?         @map("ultimo_envio_em") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(3)

  canal         CanalWhatsapp   @relation(fields: [canalId], references: [id], onDelete: Restrict)
  origemCliente OrigemCliente?  @relation(fields: [origemClienteId], references: [id], onDelete: Restrict)
  envios        EnvioCampanha[]

  @@index([ativa])
  @@map("mensagens_automaticas")
}

/// Dono: comercial-atendimento. Um destinatário de uma campanha ou de um disparo diário de
/// mensagem automática. Vira uma mensagem "Pendente" no WhatsApp na hora programada.
model EnvioCampanha {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campanhaId           String?             @map("campanha_id") @db.Uuid
  mensagemAutomaticaId String?             @map("mensagem_automatica_id") @db.Uuid
  /// Dia do disparo da mensagem automática (fuso da clínica).
  dia                  DateTime?           @db.Date
  pacienteId           String              @map("paciente_id") @db.Uuid
  programadoPara       DateTime            @map("programado_para") @db.Timestamptz(3)
  status               EnvioCampanhaStatus @default(PROGRAMADO)
  mensagemWhatsappId   String?             @unique @map("mensagem_whatsapp_id") @db.Uuid
  /// Motivo da falha (sem dados pessoais).
  erro                 String?
  enfileiradoEm        DateTime?           @map("enfileirado_em") @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  campanha           Campanha?           @relation(fields: [campanhaId], references: [id], onDelete: Restrict)
  mensagemAutomatica MensagemAutomatica? @relation(fields: [mensagemAutomaticaId], references: [id], onDelete: Restrict)
  paciente           Paciente            @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  mensagemWhatsapp   MensagemWhatsapp?   @relation(fields: [mensagemWhatsappId], references: [id], onDelete: SetNull)

  @@unique([campanhaId, pacienteId])
  @@unique([mensagemAutomaticaId, pacienteId, dia])
  @@index([status, programadoPara])
  @@index([pacienteId])
  @@map("envios_campanha")
}

enum ConfirmacaoEtapa {
  MSG1
  MSG2
  MSG3
  LEMBRETE

  @@map("confirmacao_etapa")
}

enum ConfirmacaoEnvioStatus {
  ENVIADO
  FALHA

  @@map("confirmacao_envio_status")
}

/// Dono: comercial-atendimento. "Configuração Geral" da tela Confirmações (`/confirmacoes`):
/// uma única linha (`id = 1`), criada com os padrões na primeira leitura.
model ConfiguracaoConfirmacao {
  id                   Int      @id @default(1)
  ativo                Boolean  @default(true)
  /// Dias entre o envio da MSG1/2/3 e a consulta (1 = véspera, 2 = dois dias antes).
  antecedenciaDias     Int      @default(1) @map("antecedencia_dias")
  /// "HH:MM" no fuso da clínica.
  horarioLembrete      String   @map("horario_lembrete")
  horarioMsg1          String   @map("horario_msg1")
  horarioMsg2          String   @map("horario_msg2")
  horarioMsg3          String   @map("horario_msg3")
  /// Horário da varredura "Não confirmou" (alimenta a central de pendências, #160).
  horarioNaoConfirmou  String   @map("horario_nao_confirmou")
  mensagemCriacao      String   @map("mensagem_criacao")
  mensagemConfirmada   String   @map("mensagem_confirmada")
  mensagemJaConfirmado String   @map("mensagem_ja_confirmado")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("configuracao_confirmacao")
}

/// Dono: comercial-atendimento. Textos de confirmação de um tipo de agendamento ("Modelos de
/// Mensagem por Tipo"). Um modelo por tipo; exclusão lógica. Tipo sem modelo usa o padrão.
model ModeloConfirmacao {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipoAgendamentoId     String    @unique @map("tipo_agendamento_id") @db.Uuid
  msg1                  String
  msg2                  String
  msg3                  String
  lembreteConfirmado    String    @map("lembrete_confirmado")
  lembreteNaoConfirmado String    @map("lembrete_nao_confirmado")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)

  tipoAgendamento TipoAgendamento @relation(fields: [tipoAgendamentoId], references: [id], onDelete: Restrict)

  @@map("modelos_confirmacao")
}

/// Dono: comercial-atendimento. Uma mensagem de confirmação (MSG1/2/3 ou lembrete) de um
/// agendamento. Único por agendamento e etapa: garante que o envio não se repete. Também é o
/// "Histórico" da tela.
model EnvioConfirmacao {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agendamentoId      String                 @map("agendamento_id") @db.Uuid
  etapa              ConfirmacaoEtapa
  status             ConfirmacaoEnvioStatus
  /// Motivo da falha (sem dados pessoais), ex.: SEM_CANAL, SEM_CELULAR.
  erro               String?
  /// Quando a recepção disparou o envio pela linha; vazio = agendador.
  manual             Boolean                @default(false)
  mensagemWhatsappId String?                @unique @map("mensagem_whatsapp_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  agendamento      Agendamento       @relation(fields: [agendamentoId], references: [id], onDelete: Restrict)
  mensagemWhatsapp MensagemWhatsapp? @relation(fields: [mensagemWhatsappId], references: [id], onDelete: SetNull)

  @@unique([agendamentoId, etapa])
  @@index([createdAt])
  @@map("envios_confirmacao")
}

/// Dono: compras-estoque. Baixa de insumos (tela `/baixa-insumos`, issue #17). Imutável: sem
/// `updatedAt` nem exclusão. A baixa de saldo é uma `MovimentacaoEstoque` de saída por item.
/// `usuarioId` é o responsável (Usuário é de configuracoes-gestao: sem FK).
model BaixaInsumo {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pacienteId      String?  @map("paciente_id") @db.Uuid
  profissionalId  String?  @map("profissional_id") @db.Uuid
  unidadeId       String?  @map("unidade_id") @db.Uuid
  pressaoArterial String?  @map("pressao_arterial")
  dextro          String?
  observacao      String?
  usuarioId       String?  @map("usuario_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  paciente     Paciente?          @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  profissional Profissional?      @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  unidade      Unidade?           @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  itens        BaixaInsumoItem[]

  @@index([createdAt])
  @@index([pacienteId])
  @@map("baixas_insumos")
}

model BaixaInsumoItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  baixaId    String  @map("baixa_id") @db.Uuid
  produtoId  String  @map("produto_id") @db.Uuid
  quantidade Decimal @db.Decimal(12, 3)

  baixa   BaixaInsumo @relation(fields: [baixaId], references: [id], onDelete: Cascade)
  produto Produto     @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([baixaId])
  @@index([produtoId])
  @@map("baixas_insumos_itens")
