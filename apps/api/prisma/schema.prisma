  @@index([vendaId])
  @@map("venda_itens")
}

enum PacoteStatus {
  ATIVO
  CANCELADO

  @@map("pacote_status")
}

/// Dono: comercial-atendimento. Pacote de sessões do paciente (tela Pacotes, `/pacotes`). Só
/// ATIVO e CANCELADO são gravados: Finalizado (saldo zerado) e Vencido (passou a data) são
/// calculados na leitura. `sessoesTotal` (soma das quantidades dos itens) e `sessoesUsadas` (soma
/// dos usos) são mantidos pelo service. Exclusão lógica: histórico comercial.
model Pacote {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pacienteId     String       @map("paciente_id") @db.Uuid
  nome           String
  descricao      String?
  /// Valor informado no modal ou, na falta dele, a soma dos itens.
  valorTotal     Decimal      @map("valor_total") @db.Decimal(12, 2)
  dataInicio     DateTime?    @map("data_inicio") @db.Date
  dataVencimento DateTime?    @map("data_vencimento") @db.Date
  profissionalId String?      @map("profissional_id") @db.Uuid
  observacoes    String?
  sessoesTotal   Int          @map("sessoes_total")
  sessoesUsadas  Int          @default(0) @map("sessoes_usadas")
  status         PacoteStatus @default(ATIVO)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)

  paciente     Paciente      @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  profissional Profissional? @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  itens        PacoteItem[]
  usos         PacoteUso[]

  @@index([pacienteId])
  @@index([status])
  @@index([dataVencimento])
  @@index([createdAt])
  @@map("pacotes")
}

/// Dono: comercial-atendimento. Item do pacote: nome e preço ficam copiados do produto (snapshot)
/// e a quantidade é o número de sessões do item.
model PacoteItem {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pacoteId      String  @map("pacote_id") @db.Uuid
  /// Produto/procedimento de origem (sem FK: o item é um snapshot).
  produtoId     String  @map("produto_id") @db.Uuid
  descricao     String
  quantidade    Int
  valorUnitario Decimal @map("valor_unitario") @db.Decimal(12, 2)
  posicao       Int     @default(0)

  pacote Pacote @relation(fields: [pacoteId], references: [id], onDelete: Cascade)

  @@index([pacoteId])
  @@map("pacote_itens")
}

/// Dono: comercial-atendimento. Uso de sessões do pacote ("Registrar Uso de Sessão").
model PacoteUso {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pacoteId       String   @map("pacote_id") @db.Uuid
  profissionalId String   @map("profissional_id") @db.Uuid
  quantidade     Int      @default(1)
  observacoes    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  pacote       Pacote       @relation(fields: [pacoteId], references: [id], onDelete: Cascade)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Restrict)

  @@index([pacoteId])
  @@index([profissionalId])
  @@map("pacote_usos")
}

enum MensalidadeStatus {
  ATIVO
  PAUSADO
  CANCELADO

  @@map("mensalidade_status")
}

/// Dono: comercial-atendimento. Cobrança recorrente mensal de um paciente (tela Mensalidades,
/// `/mensalidades`, issue #6). "Gerar Titulos do Mes" cria uma conta a receber por mensalidade
/// ativa e mês (`MensalidadeTitulo`). Exclusão lógica: histórico financeiro.
model Mensalidade {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pacienteId       String            @map("paciente_id") @db.Uuid
  descricao        String
  valor            Decimal           @db.Decimal(12, 2)
  /// 1 a 28.
  diaVencimento    Int               @map("dia_vencimento")
  formaPagamentoId String?           @map("forma_pagamento_id") @db.Uuid
  dataInicio       DateTime          @map("data_inicio") @db.Date
  dataFim          DateTime?         @map("data_fim") @db.Date
  observacoes      String?
  status           MensalidadeStatus @default(ATIVO)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(3)

  paciente       Paciente            @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  formaPagamento FormaPagamento?     @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
  titulos        MensalidadeTitulo[]

  @@index([pacienteId])
  @@index([formaPagamentoId])
  @@index([status])
  @@index([createdAt])
  @@map("mensalidades")
}

/// Título (conta a receber) gerado para a mensalidade no mês `AAAA-MM`. A chave única impede
/// gerar duas vezes o mesmo mês. A conta a receber pertence ao financeiro: guardamos só o id.
model MensalidadeTitulo {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mensalidadeId  String   @map("mensalidade_id") @db.Uuid
  /// `AAAA-MM`.
  competencia    String   @db.VarChar(7)
  contaReceberId String   @map("conta_receber_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  mensalidade Mensalidade @relation(fields: [mensalidadeId], references: [id])

  @@unique([mensalidadeId, competencia])
  @@index([mensalidadeId])
  @@map("mensalidade_titulos")
}

enum PlanoContaTipo {
  RECEITA
  DESPESA
  ATIVO
  PASSIVO
}

/// Dono: financeiro. Conta contábil em árvore (tela Plano de Contas, `/plano-contas`).
model PlanoConta {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo     String         @unique
  nome       String
  tipo       PlanoContaTipo
  /// 1 para raiz; nível do pai + 1 nas demais.
  nivel      Int            @default(1)
  contaPaiId String?        @map("conta_pai_id") @db.Uuid
  ativo      Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?      @map("deleted_at") @db.Timestamptz(3)

  contaPai      PlanoConta?    @relation("PlanoContaHierarquia", fields: [contaPaiId], references: [id], onDelete: Restrict)
  filhas        PlanoConta[]   @relation("PlanoContaHierarquia")
  contasPagar   ContaPagar[]
  contasReceber ContaReceber[]

  @@index([contaPaiId])
  @@map("planos_contas")
}

/// "Vencido" não é gravado: é calculado (PENDENTE com dataVencimento no passado), conforme
/// o sistema real (print do dev, issue #48).
enum ContaReceberStatus {
  PENDENTE
  RECEBIDO
  CANCELADO

  @@map("conta_receber_status")
}

/// Dono: financeiro. Conta a receber (tela Contas a Receber, `/receber`). Exclusão lógica:
/// histórico financeiro.
model ContaReceber {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Número exibido na coluna "#".
  numero           Int                @unique @default(autoincrement())
  descricao        String
  /// Opcional: o modal permite cadastrar sem cliente ("Buscar cliente (nome, telefone)...").
  pacienteId       String?            @map("paciente_id") @db.Uuid
  valor            Decimal            @db.Decimal(12, 2)
  dataVencimento   DateTime           @map("data_vencimento") @db.Date
  formaPagamentoId String?            @map("forma_pagamento_id") @db.Uuid
  planoContaId     String?            @map("plano_conta_id") @db.Uuid
  documento        String?
  totalParcelas    Int                @default(1) @map("total_parcelas")
  status           ContaReceberStatus @default(PENDENTE)
  /// Conta bancária e data do recebimento (status RECEBIDO), usadas pela Conciliação (#46).
  contaBancariaId  String?            @map("conta_bancaria_id") @db.Uuid
  dataRecebimento  DateTime?          @map("data_recebimento") @db.Date
  observacoes      String?
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(3)

  paciente       Paciente?       @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
  planoConta     PlanoConta?     @relation(fields: [planoContaId], references: [id], onDelete: Restrict)
  contaBancaria  ContaBancaria?  @relation(fields: [contaBancariaId], references: [id], onDelete: Restrict)

  @@index([pacienteId])
  @@index([formaPagamentoId])
  @@index([planoContaId])
  @@index([status])
  @@index([dataVencimento])
  @@index([contaBancariaId])
  @@index([dataRecebimento])
  @@map("contas_receber")
}

enum ContaBancariaTipo {
  CAIXA
  CORRENTE
  POUPANCA
  INVESTIMENTO

  @@map("conta_bancaria_tipo")
}

/// Dono: financeiro. Conta bancária, cadastrada na aba "Contas Bancárias" da tela Conciliação
/// (#46) e usada nas baixas de Contas a Pagar e nos recebimentos de Contas a Receber. Exclusão
/// lógica: histórico financeiro.
model ContaBancaria {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome             String
  tipo             ContaBancariaTipo @default(CORRENTE)
  banco            String?
  agencia          String?
  conta            String?
  saldoInicial     Decimal           @default(0) @map("saldo_inicial") @db.Decimal(14, 2)
  /// Pagamentos e recebimentos a partir desta data somam no saldo. Nula: todos.
  dataSaldoInicial DateTime?         @map("data_saldo_inicial") @db.Date
  ativo            Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(3)

  baixas        ContaPagarBaixa[]
  contasReceber ContaReceber[]

  @@map("contas_bancarias")
}

enum ContaPagarBeneficiarioTipo {
  FORNECEDOR
  FUNCIONARIO

  @@map("conta_pagar_beneficiario_tipo")
}

enum ContaPagarStatus {
  PENDENTE
  PAGO
  CANCELADO

  @@map("conta_pagar_status")
}

/// Dono: financeiro. Conta a pagar (tela Contas a Pagar, `/pagar`). O beneficiário é um
/// Fornecedor (compras-estoque) ou um Funcionário (regulatorio-qualidade), sem FK: o acesso é
/// pelos services exportados de cada módulo (CLAUDE.md, seção 3). Exclusão lógica: histórico
/// financeiro.
model ContaPagar {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Número exibido na coluna "#".
  numero           Int                        @unique @default(autoincrement())
  descricao        String
  beneficiarioTipo ContaPagarBeneficiarioTipo @default(FORNECEDOR) @map("beneficiario_tipo")
  /// Preenchido quando beneficiarioTipo = FORNECEDOR (sem FK).
  fornecedorId     String?                    @map("fornecedor_id") @db.Uuid
  /// Preenchido quando beneficiarioTipo = FUNCIONARIO (sem FK).
  funcionarioId    String?                    @map("funcionario_id") @db.Uuid
  valor            Decimal                    @db.Decimal(12, 2)
  dataVencimento   DateTime                   @map("data_vencimento") @db.Date
  formaPagamentoId String?                    @map("forma_pagamento_id") @db.Uuid
  planoContaId     String?                    @map("plano_conta_id") @db.Uuid
  documento        String?
  totalParcelas    Int                        @default(1) @map("total_parcelas")
  status           ContaPagarStatus           @default(PENDENTE)
  observacoes      String?
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?                  @map("deleted_at") @db.Timestamptz(3)

  formaPagamento FormaPagamento?   @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
  planoConta     PlanoConta?       @relation(fields: [planoContaId], references: [id], onDelete: Restrict)
  baixas         ContaPagarBaixa[]

  @@index([fornecedorId])
  @@index([funcionarioId])
  @@index([formaPagamentoId])
  @@index([planoContaId])
  @@index([status])
  @@index([dataVencimento])
  @@map("contas_pagar")
}

/// Dono: financeiro. Baixa (pagamento total ou parcial) de uma conta a pagar. "Cancelar Baixa"
/// exclui logicamente a baixa mais recente, sem apagar o histórico, e recalcula o status.
model ContaPagarBaixa {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contaPagarId         String    @map("conta_pagar_id") @db.Uuid
  dataPagamento        DateTime  @map("data_pagamento") @db.Date
  valorPago            Decimal   @map("valor_pago") @db.Decimal(12, 2)
  juros                Decimal   @default(0) @db.Decimal(12, 2)
  desconto             Decimal   @default(0) @db.Decimal(12, 2)
  formaPagamentoId     String?   @map("forma_pagamento_id") @db.Uuid
  contaBancariaId      String?   @map("conta_bancaria_id") @db.Uuid
  documento            String?
  observacoes          String?
  /// Arquivo enviado em `/api/arquivos` (uso `comprovante-conta-pagar`), sem FK.
  comprovanteArquivoId String?   @map("comprovante_arquivo_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  contaPagar     ContaPagar      @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
  contaBancaria  ContaBancaria?  @relation(fields: [contaBancariaId], references: [id], onDelete: Restrict)

  @@index([contaPagarId])
  @@map("contas_pagar_baixas")
}

enum AtendimentoTipo {
  CONSULTA
  RETORNO
  PROCEDIMENTO
  EXAME

  @@map("atendimento_tipo")
}

enum AtendimentoStatus {
  EM_ANDAMENTO
  FINALIZADO

  @@map("atendimento_status")
}

/// Dono: consultorio-assistencial. Prontuário médico (aba "Prontuário" da tela Prontuários,
/// `/prontuarios`): alergias, medicamentos em uso etc. 1 por paciente, criado/atualizado pelo
/// único botão "Salvar" (upsert). `id` é o mesmo id do Paciente (comercial-atendimento, sem FK:
/// CLAUDE.md, seção 3), por isso não tem `@default`.
model Prontuario {
  id                  String   @id @map("paciente_id") @db.Uuid
  alergias            String?
  medicamentosEmUso   String?  @map("medicamentos_em_uso")
  doencasCronicas     String?  @map("doencas_cronicas")
  cirurgiasAnteriores String?  @map("cirurgias_anteriores")
  historicoFamiliar   String?  @map("historico_familiar")
  observacoes         String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("prontuarios")
}

/// Dono: consultorio-assistencial. Atendimento clínico (aba "Atendimentos" da tela Prontuários).
/// `horario`/`procedimentoId`/`pagamentoStatus` ficam reservados para a tela Atendimento Médico
/// (#38, agenda do dia), que deve reaproveitar esta mesma entidade.
model Atendimento {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Paciente (comercial-atendimento), sem FK: acesso pelo service exportado.
  pacienteId      String            @map("paciente_id") @db.Uuid
  /// Profissional (gestao-profissionais), sem FK: acesso pelo service exportado.
  profissionalId  String            @map("profissional_id") @db.Uuid
  tipo            AtendimentoTipo?
  queixa          String?
  evolucao        String?
  diagnostico     String?
  conduta         String?
  observacoes     String?
  status          AtendimentoStatus @default(EM_ANDAMENTO)
  /// Reservado para #38 (agenda do dia): data/hora do agendamento.
  horario         DateTime?         @db.Timestamptz(3)
  /// Reservado para #38: procedimento da agenda, sem FK.
  procedimentoId  String?           @map("procedimento_id") @db.Uuid
  /// Reservado para #38: situação do pagamento do atendimento.
  pagamentoStatus String?           @map("pagamento_status")
  /// Agendamento (comercial-atendimento) que originou o atendimento na tela Atendimento Médico
  /// (#38), sem FK. Um atendimento por agendamento.
  agendamentoId   String?           @unique @map("agendamento_id") @db.Uuid
