# Copie para .env e troque os valores. Nunca commite o .env.

# Porta externa do front (publicada em 0.0.0.0)
WEB_PORT=5173

# PostgreSQL (somente rede interna do Docker)
POSTGRES_USER=torres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=torres
DATABASE_URL=postgresql://torres:troque-esta-senha@postgres:5432/torres
# Banco dos testes (e2e apagam dados): o nome precisa terminar com _test
DATABASE_URL_TEST=postgresql://torres:troque-esta-senha@postgres:5432/torres_test

# RabbitMQ (AMQP só na rede interna; painel em 127.0.0.1:15672)
RABBITMQ_DEFAULT_USER=torres
RABBITMQ_DEFAULT_PASS=troque-esta-senha
RABBITMQ_URL=amqp://torres:troque-esta-senha@rabbitmq:5672
# RabbitMQ dos testes (opcional; padrão: RABBITMQ_URL). Ex.: outro vhost.
# RABBITMQ_URL_TEST=
# Mensageria (padrões entre parênteses): tentativas antes da DLQ (5), espera inicial e máxima
# do retry em ms (1000 e 60000), prefetch por fila (10), varredura da outbox em ms (1000),
# eventos por varredura (50) e dias de retenção de processed_events (30).
# MESSAGING_MAX_ATTEMPTS=5
# MESSAGING_RETRY_BASE_MS=1000
# MESSAGING_RETRY_MAX_MS=60000
# MESSAGING_PREFETCH=10
# MESSAGING_OUTBOX_INTERVAL_MS=1000
# MESSAGING_OUTBOX_BATCH_SIZE=50
# MESSAGING_PROCESSED_RETENTION_DAYS=30

# Agendador de campanhas e mensagens automáticas (roda a cada minuto). off desliga.
# CAMPANHAS_AGENDADOR=on

# Endereço do front, usado nos links enviados por WhatsApp (pesquisa do profissional). Padrão: http://localhost:5173
# WEB_BASE_URL=http://localhost:5173

# API
API_PORT=3000
LOG_LEVEL=info
# Swagger em /api/docs: ligado fora de produção. Em produção, só com SWAGGER_ENABLED=true.
# SWAGGER_ENABLED=false

# Armazenamento de arquivos. No Docker Compose: MinIO (S3) só na rede interna,
# console em 127.0.0.1:9001. Fora do Docker: STORAGE_DRIVER=local (grava em STORAGE_LOCAL_DIR).
MINIO_ROOT_USER=torres
MINIO_ROOT_PASSWORD=troque-esta-senha
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_BUCKET=torres-arquivos
# Bucket dos testes (e2e gravam arquivos): o nome precisa terminar com -test
STORAGE_S3_BUCKET_TEST=torres-arquivos-test
STORAGE_S3_ACCESS_KEY=torres
STORAGE_S3_SECRET_KEY=troque-esta-senha
# STORAGE_LOCAL_DIR=storage
# Segredo das URLs temporárias de download (mínimo 32 caracteres): openssl rand -base64 32
STORAGE_URL_SECRET=troque-este-segredo-por-um-valor-aleatorio
# Validade das URLs temporárias, em segundos
# STORAGE_URL_TTL_SECONDS=300

# Autenticação. Segredo do access token (mínimo 32 caracteres): openssl rand -base64 48
AUTH_JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
# Chave que cifra credenciais de terceiros gravadas no banco (ex.: Memed). Mínimo 32 caracteres:
# openssl rand -base64 32. Sem ela, usa-se AUTH_JWT_SECRET. Trocar a chave invalida o que já foi gravado.
# SECRETS_ENCRYPTION_KEY=
# Cookie do refresh token só em HTTPS. Em desenvolvimento por http://<host>:5173, use false.
AUTH_COOKIE_SECURE=false
# Validades em segundos (padrões: access 15 min, sessão 7 dias, link de senha 1 h)
# AUTH_ACCESS_TTL_SECONDS=900
# AUTH_REFRESH_TTL_SECONDS=604800
# AUTH_RESET_TTL_SECONDS=3600
# Rate limit por IP e por minuto (padrões: login 5, esqueci/redefinir senha 3)
# AUTH_LOGIN_LIMIT_PER_MINUTE=5
# AUTH_PASSWORD_LIMIT_PER_MINUTE=3
# Backup automático (issue #157). Desligado por padrão; em produção: BACKUP_ATIVO=on.
# Gera um dump diário do PostgreSQL e copia os arquivos do storage, tudo cifrado (AES-256-GCM),
# para um bucket S3 FORA do servidor principal. Veja a seção "Backup e restauração" do README.
# BACKUP_ATIVO=off
# Frase que cifra os backups (mínimo 32 caracteres): openssl rand -base64 48.
# GUARDE UMA CÓPIA FORA DO SERVIDOR: sem ela o backup não pode ser restaurado.
# BACKUP_CRIPTO_CHAVE=
# Destino externo (S3 compatível: AWS S3, Backblaze B2, Wasabi, MinIO em outro servidor...)
# BACKUP_DESTINO_ENDPOINT=
# BACKUP_DESTINO_REGION=us-east-1
# BACKUP_DESTINO_BUCKET=
# BACKUP_DESTINO_ACCESS_KEY=
# BACKUP_DESTINO_SECRET_KEY=
# BACKUP_DESTINO_PREFIXO=torres
# Retenção: dumps diários, semanais e mensais mantidos (padrões 7, 4 e 6)
# BACKUP_RETENCAO_DIARIOS=7
# BACKUP_RETENCAO_SEMANAIS=4
# BACKUP_RETENCAO_MENSAIS=6
# Horários (cron, fuso America/Sao_Paulo): backup diário às 2h e restauração de teste aos domingos, 4h
# BACKUP_CRON=0 2 * * *
# BACKUP_RESTAURACAO_CRON=0 4 * * 0
# Servidor onde a restauração de teste cria o banco descartável (padrão: o mesmo servidor do
# DATABASE_URL). O ideal é outro servidor: postgresql://usuario:senha@host:5432/postgres
# BACKUP_RESTAURACAO_URL=
# Webhook que recebe o alerta de falha (POST JSON, sem dados pessoais). Opcional.
# BACKUP_ALERTA_WEBHOOK_URL=

# Senha do usuário admin@example.com criado pelo seed (só desenvolvimento)
SEED_ADMIN_PASSWORD=troque-esta-senha-1
