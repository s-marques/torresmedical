# Copie para .env e troque os valores. Nunca commite o .env.

# Porta externa do front (publicada em 0.0.0.0)
WEB_PORT=5173

# PostgreSQL (somente rede interna do Docker)
POSTGRES_USER=torres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=torres
DATABASE_URL=postgresql://torres:troque-esta-senha@postgres:5432/torres

# RabbitMQ (AMQP só na rede interna; painel em 127.0.0.1:15672)
RABBITMQ_DEFAULT_USER=torres
RABBITMQ_DEFAULT_PASS=troque-esta-senha
RABBITMQ_URL=amqp://torres:troque-esta-senha@rabbitmq:5672

# API
API_PORT=3000
LOG_LEVEL=info
